PORT=3000
# Postgres propio de la app (en el VPS: host "postgres" de la red data).
DATABASE_URL=postgres://adoptree:<pass>@postgres:5432/adoptree
JWT_SECRET=
# Login con Google (POST /auth/google): solo usa el Client ID, el mismo que VITE_GOOGLE_CLIENT_ID del front.
GOOGLE_CLIENT_ID=
# Exigidas al arrancar pero sin uso (la estrategia de passport no está registrada): cualquier valor sirve.
GOOGLE_CLIENT_SECRET=x
GOOGLE_CALLBACK_URL=x
# Front: CORS de Socket.IO y back_urls de Mercado Pago.
FRONT_URL=https://adoptree.vercel.app
# Mercado Pago. Sin el token real, crear un pago falla; el resto anda.
MP_ACCESS_TOKEN=
MP_WEBHOOK=https://api-adoptree.emacuello.dev/payments/webhook
# Opcional: "true" loguea cada query de Prisma.
DB_LOGS=false
